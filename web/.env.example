# Server-only URL for the FastAPI inference service.
# Local development:
INFERENCE_API_URL=http://127.0.0.1:8000
# In production (Vercel), use https://<your-railway-domain> and
# the SAME secret used by Railway SPINAL_API_TOKEN.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# NEVER prefix secret with NEXT_PUBLIC_ or commit .env.local.
# SPINAL_API_TOKEN=REPLACE_WITH_A_RANDOM_PRIVATE_SECRET
